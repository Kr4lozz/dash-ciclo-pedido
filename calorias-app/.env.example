# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables.

# API key de Anthropic (https://console.anthropic.com → API Keys). Obligatoria.
ANTHROPIC_API_KEY=

# Código que pedirá la app para usar la IA (evita que otros gasten tu saldo con tu link).
# Obligatorio en Vercel. Inventa uno largo y escríbelo luego en Perfil → Conexión con la IA.
APP_ACCESS_CODE=

# Opcional: modelo de Claude. Por defecto claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
