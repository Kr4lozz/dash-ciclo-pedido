# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables.

# API key gratuita de Google Gemini (https://aistudio.google.com/apikey). Obligatoria.
GEMINI_API_KEY=

# Código familiar: se pide una sola vez al crear cada cuenta (y, sin base de datos,
# para usar la IA). Inventa uno y compártelo solo con tu familia.
APP_ACCESS_CODE=

# Base de datos para las cuentas (Upstash Redis). Vercel las agrega sola al conectar
# Storage → Upstash. Sin ellas la app funciona en modo local (datos solo en el dispositivo).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcionales
# GEMINI_MODEL=gemini-flash-latest   # modelo principal; si está saturado se usa gemini-flash-lite-latest
# AI_DAILY_LIMIT=40                  # análisis con IA por persona y día
# GUEST_AI_DAILY_LIMIT=5             # análisis por día para quien prueba sin cuenta (por IP)

# IA de respaldo: se usa solo si Gemini falla. Con una llave basta (gratis en console.groq.com/keys
# o console.mistral.ai/api-keys); se prueban en este orden. Cada una admite su *_MODEL.
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# Cualquier otra IA con API compatible con OpenAI (y que acepte imágenes):
# FALLBACK_AI_BASE_URL=https://openrouter.ai/api/v1
# FALLBACK_AI_API_KEY=
# FALLBACK_AI_MODEL=
# FALLBACK_AI_NAME=Respaldo
# AI_ATTEMPT_TIMEOUT_MS=30000        # tope de tiempo por intento (el total por análisis es 55 s)
# GEMINI_BASE_URL=                   # solo para pruebas o un proxy; ver scripts/mock-ai.mjs
