# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables.

# API key gratuita de Google Gemini (https://aistudio.google.com/apikey). Obligatoria.
GEMINI_API_KEY=

# Código que pedirá la app para usar la IA (evita que otros gasten tu cuota con tu link).
# Obligatorio en Vercel. Inventa uno largo y escríbelo luego en Perfil → Conexión con la IA.
APP_ACCESS_CODE=

# Opcional: modelo de Gemini. Por defecto gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest
