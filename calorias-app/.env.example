# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables.

# API key gratuita de Google Gemini (https://aistudio.google.com/apikey). Obligatoria.
GEMINI_API_KEY=

# Código familiar: se pide una sola vez al crear cada cuenta (y, sin base de datos,
# para usar la IA). Inventa uno y compártelo solo con tu familia.
APP_ACCESS_CODE=

# Base de datos para las cuentas (Upstash Redis). Vercel las agrega sola al conectar
# Storage → Upstash. Sin ellas la app funciona en modo local (datos solo en el dispositivo).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcionales
# GEMINI_MODEL=gemini-flash-latest   # modelo principal; si está saturado se usa gemini-flash-lite-latest
# AI_DAILY_LIMIT=40                  # análisis con IA por persona y día
# GUEST_AI_DAILY_LIMIT=5             # análisis por día para quien prueba sin cuenta (por IP)
